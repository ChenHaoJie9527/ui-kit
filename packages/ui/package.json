{
  "name": "@ui-kit/ui",
  "version": "0.1.0",
  "description": "基于 @ui-kit/hooks 的 React 组件库：Button、Input、Switch、Tabs、Dialog、Toast",
  "license": "MIT",
  "author": "ChenHaoJie9527",
  "homepage": "https://chenhaojie9527.github.io/ui-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenHaoJie9527/ui-kit.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/ChenHaoJie9527/ui-kit/issues"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "tabs",
    "dialog",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ui-kit/hooks": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
