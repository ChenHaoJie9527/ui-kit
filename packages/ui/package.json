{
  "name": "seam-react",
  "version": "0.9.1",
  "description": "基于 seam-hooks 与 Motion 的 Fluid React 组件库",
  "keywords": [
    "component-library",
    "dialog",
    "fluid",
    "marquee",
    "motion",
    "react",
    "sidebar",
    "tabs",
    "tooltip",
    "typescript",
    "ui"
  ],
  "homepage": "https://chenhaojie9527.github.io/ui-kit/",
  "bugs": {
    "url": "https://github.com/ChenHaoJie9527/ui-kit/issues"
  },
  "license": "MIT",
  "author": "ChenHaoJie9527",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenHaoJie9527/ui-kit.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "types": "./dist/SeamStyles.d.ts",
      "import": "./dist/styles.js",
      "require": "./dist/styles.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "generate:styles": "node scripts/generate-styles.mjs",
    "build": "pnpm generate:styles && pnpm exec oxfmt src/styles.generated.ts && vite build && pnpm exec tsrs -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "pnpm exec tsrs --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "motion": "^14.4.0",
    "seam-hooks": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.4"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "engines": {
    "node": ">=18"
  }
}
