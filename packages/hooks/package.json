{
  "name": "seam-hooks",
  "version": "0.1.1",
  "description": "29 个生产级 React hooks：受控状态、虚拟滚动、异步竞态、焦点管理与浏览器能力封装",
  "keywords": [
    "hooks",
    "react",
    "typescript",
    "ui-kit",
    "use-async",
    "virtual-list"
  ],
  "homepage": "https://chenhaojie9527.github.io/ui-kit/",
  "bugs": {
    "url": "https://github.com/ChenHaoJie9527/ui-kit/issues"
  },
  "license": "MIT",
  "author": "ChenHaoJie9527",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenHaoJie9527/ui-kit.git",
    "directory": "packages/hooks"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=18"
  }
}
