{
  "name": "ui-kit",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build:docs": "vite build apps/docs --base ./ --outDir ../../docs --emptyOutDir"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
