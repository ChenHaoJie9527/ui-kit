{
  "name": "ui-kit",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:commitlint": "sh scripts/check-commitlint.sh",
    "dev": "pnpm --filter @chenhaojie9527/docs dev",
    "dev:docs": "pnpm --filter @chenhaojie9527/docs dev",
    "build:docs": "pnpm --filter @chenhaojie9527/docs build",
    "commit": "cz",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/update-component-releases.mjs && pnpm format",
    "publish:npm": "node scripts/publish-npm.mjs",
    "release": "pnpm build && pnpm publish:npm",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
